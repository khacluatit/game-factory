# ===== Mangal Mandir (मंगल मंदिर) — đền Hindu 3D, IAP trang trí, không quảng cáo =====
GAME_NAME="MangalMandir"
APP_DISPLAY_NAME="Mangal Mandir"
BUNDLE_ID="com.beemob.mangalmandir"
MARKETING_VERSION="1.0.0"
PRIVACY_URL="https://khacluatit.github.io/game-factory/mangalmandir/privacy.html"
# screenshots.sh: mỗi giá trị = 1 ảnh, app mở với -shot <giá trị>
SHOT_LIST="gate darshan aarti japa yard panchang"
SHOT_WAIT="14"
SHOT_LANGS="en-US:en hi:hi"
# App Store Connect app id: 6832909789
# Build gắn vào phiên bản khi chạy lane submit (để trống = build mới nhất)
SUBMIT_BUILD=
