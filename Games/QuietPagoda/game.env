# ===== Quiet Pagoda (Chùa Tĩnh Tâm) — app 3D offline, IAP $0.99, không quảng cáo =====
GAME_NAME="QuietPagoda"
APP_DISPLAY_NAME="Quiet Pagoda"
BUNDLE_ID="com.beemob.quietpagoda"
MARKETING_VERSION="1.0.0"
PRIVACY_URL="https://khacluatit.github.io/game-factory/quietpagoda/privacy.html"
# screenshots.sh: mỗi giá trị = 1 ảnh, app mở với -shot <giá trị>
SHOT_LIST="hall sit pond journal"
SHOT_WAIT="14"
SHOT_LANGS="en-US:en vi:vi zh-Hant:zh-Hant"
# App Store Connect app id: 6830940994
# IAP ids: incense 6830941326, lantern 6830941531, fruit 6830941358, robes 6830941410, beads 6830941360, tet 6830941536

# Build gắn vào phiên bản khi chạy lane submit (để trống = build mới nhất)
SUBMIT_BUILD=4
# retry
# retry2
IAP_SHOTS_ONLY=1
