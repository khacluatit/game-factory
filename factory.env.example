# Copy thành factory.env (đã gitignore) rồi điền. KHÔNG commit file này, KHÔNG gửi vào chat.
TEAM_ID="XXXXXXXXXX"                 # Apple Developer → Membership → Team ID
BUNDLE_PREFIX="com.yourstudio"       # tiền tố bundle id cho mọi game
GITHUB_PAGES_URL="https://yourname.github.io/game-factory"   # để host privacy policy
SUPPORT_EMAIL="you@example.com"

# App Store Connect API key (Users and Access → Integrations → App Store Connect API, quyền App Manager)
ASC_KEY_ID="XXXXXXXXXX"
ASC_ISSUER_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
ASC_KEY_PATH="$HOME/.appstoreconnect/AuthKey_XXXXXXXXXX.p8"
