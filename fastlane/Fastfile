# Được gọi qua scripts/ship.sh (đã nạp factory.env + game.env vào ENV).
opt_out_usage
skip_docs
default_platform(:ios)

platform :ios do
  before_all do
    @game = ENV.fetch("GAME_NAME")
    @dir  = ENV.fetch("GAME_DIR")
    @bid  = ENV.fetch("BUNDLE_ID")
    @auth = "-allowProvisioningUpdates " \
            "-authenticationKeyPath #{ENV.fetch('ASC_KEY_PATH')} " \
            "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} " \
            "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_PATH"]
    )
  end

  desc "Tạo app record trên App Store Connect (cần Apple ID, chạy 1 lần/game)"
  lane :create_app do
    produce(
      username: ENV.fetch("APPLE_ID"),
      app_identifier: @bid,
      app_name: ENV.fetch("APP_DISPLAY_NAME"),
      language: "English",
      app_version: ENV["MARKETING_VERSION"],
      sku: @bid.gsub(".", "_"),
      team_id: ENV["TEAM_ID"]
    )
  end

  desc "Build Release + upload TestFlight"
  lane :beta do
    latest = begin
      latest_testflight_build_number(app_identifier: @bid, version: ENV["MARKETING_VERSION"])
    rescue StandardError
      0
    end
    build = latest.to_i + 1
    increment_build_number(build_number: build, xcodeproj: "#{@dir}/#{@game}.xcodeproj")

    build_app(
      project: "#{@dir}/#{@game}.xcodeproj",
      scheme: @game,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "#{@dir}/build",
      buildlog_path: "#{@dir}/build/logs",
      clean: true,
      # gym dùng xcargs cho cả archive lẫn export → chỉ để cờ xác thực, không để build setting
      xcargs: @auth,
      export_options: { signingStyle: "automatic", teamID: ENV["TEAM_ID"] }
    )

    upload_to_testflight(
      app_identifier: @bid,
      skip_waiting_for_build_processing: true
    )
    UI.success("🚀 #{@game} build #{build} đã lên TestFlight")
  end

  desc "Đẩy metadata + screenshots (không submit review)"
  lane :metadata do
    shots = "#{@dir}/screenshots"
    common = {
      app_identifier: @bid,
      app_version: ENV["MARKETING_VERSION"],
      metadata_path: "#{@dir}/metadata",
      skip_binary_upload: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    }
    # 1) Screenshots trước (tách riêng để lỗi metadata không chặn ảnh)
    if Dir.exist?(shots)
      deliver(common.merge(screenshots_path: shots, overwrite_screenshots: true, skip_metadata: true))
    end
    # 2) Text metadata — app mới đôi khi bị lỗi "No data" của spaceship; không làm hỏng cả lane
    begin
      deliver(common.merge(skip_screenshots: true))
    rescue StandardError => e
      UI.important("⚠️ Metadata text lỗi (#{e.message}) — điền tay trên App Store Connect")
    end
  end

  desc "Gắn build (SUBMIT_BUILD hoặc build mới nhất) vào phiên bản, nộp kèm IAP, rồi Submit for Review"
  lane :submit do
    api = Spaceship::ConnectAPI
    app = api::App.find(@bid) or UI.user_error!("Không thấy app #{@bid}")
    shots_only = ENV["IAP_SHOTS_ONLY"] == "1"
    unless shots_only
    ver = app.get_edit_app_store_version(platform: api::Platform::IOS) or UI.user_error!("Không có phiên bản đang soạn")
    UI.message("Phiên bản #{ver.version_string} — trạng thái #{ver.app_store_state}")
    num = ENV["SUBMIT_BUILD"].to_s.strip
    builds = api::Build.all(app_id: app.id, version: ver.version_string, sort: "-uploadedDate", limit: 10)
    build = num.empty? ? builds.first : builds.find { |b| b.version == num }
    UI.user_error!("Không thấy build #{num}") unless build
    UI.user_error!("Build #{build.version} chưa xử lý xong (#{build.processing_state})") unless build.processing_state == "VALID"
    ver.select_build(build_id: build.id)
    UI.success("Đã gắn build #{build.version} vào #{ver.version_string}")
    end

    # IAP lần đầu phải nộp cùng phiên bản app
    rc = api.client.tunes_request_client
    iaps = rc.get("v1/apps/#{app.id}/inAppPurchasesV2", { limit: 50 }).body["data"] || []
    # Ảnh duyệt IAP: Games/<game>/review/iap-<consumable|nonconsumable>.jpg (hoặc iap-<productId>.jpg)
    require "digest"; require "net/http"
    iaps.each do |i|
      a = i["attributes"]
      pid = a["productId"]; kind = a["inAppPurchaseType"].to_s.downcase.delete("_")
      file = ["#{@dir}/review/iap-#{pid}.jpg", "#{@dir}/review/iap-#{kind}.jpg"].find { |f| File.exist?(f) }
      unless file then UI.important("IAP #{pid}: không có ảnh duyệt trong review/"); next end
      begin
        old = rc.get("v2/inAppPurchases/#{i['id']}/appStoreReviewScreenshot").body["data"] rescue nil
        rc.delete("v1/inAppPurchaseAppStoreReviewScreenshots/#{old['id']}") if old && old["attributes"]["assetDeliveryState"].to_h["state"] != "COMPLETE"
        next if old && old["attributes"]["assetDeliveryState"].to_h["state"] == "COMPLETE"
        bytes = File.binread(file)
        res = rc.post("v1/inAppPurchaseAppStoreReviewScreenshots", { data: { type: "inAppPurchaseAppStoreReviewScreenshots",
          attributes: { fileName: File.basename(file), fileSize: bytes.bytesize },
          relationships: { inAppPurchaseV2: { data: { type: "inAppPurchases", id: i["id"] } } } } }).body["data"]
        res["attributes"]["uploadOperations"].each do |op|
          uri = URI(op["url"]); req = Net::HTTP.const_get(op["method"].capitalize).new(uri)
          (op["requestHeaders"] || []).each { |h| req[h["name"]] = h["value"] }
          req.body = bytes.byteslice(op["offset"], op["length"])
          r = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |h| h.request(req) }
          UI.user_error!("PUT ảnh lỗi #{r.code}") unless r.code.to_i < 300
        end
        rc.patch("v1/inAppPurchaseAppStoreReviewScreenshots/#{res['id']}", { data: { type: "inAppPurchaseAppStoreReviewScreenshots", id: res["id"],
          attributes: { uploaded: true, sourceFileChecksum: Digest::MD5.hexdigest(bytes) } } })
        UI.success("IAP #{pid}: đã tải ảnh duyệt #{File.basename(file)}")
      rescue StandardError => e
        UI.important("IAP #{pid}: tải ảnh lỗi — #{e.message}")
      end
    end
    # chờ Apple xử lý xong ảnh duyệt (tối đa ~5 phút) trước khi nộp gói mua
    20.times do
      pending = iaps.select do |i|
        next false if i["attributes"]["state"] == "APPROVED"
        d = (rc.get("v2/inAppPurchases/#{i['id']}/appStoreReviewScreenshot").body["data"] rescue nil)
        d && d["attributes"]["assetDeliveryState"].to_h["state"] != "COMPLETE"
      end
      break if pending.empty?
      UI.message("Đang chờ Apple xử lý ảnh duyệt: #{pending.map { |i| i['attributes']['productId'] }.join(', ')}")
      sleep 15
    end
    if shots_only
      iaps.each do |i|
        d = rc.get("v2/inAppPurchases/#{i['id']}/appStoreReviewScreenshot").body["data"] rescue nil
        UI.message("IAP #{i['attributes']['productId']}: ảnh #{d ? d['attributes']['assetDeliveryState'].to_h['state'] : 'không có'}")
      end
      next
    end
    sub = app.get_review_submissions(filter: { state: "READY_FOR_REVIEW", platform: "IOS" }).first ||
          app.create_review_submission(platform: api::Platform::IOS)
    unless (sub.items || []).any?
      begin
        sub.add_app_store_version_to_review_items(app_store_version_id: ver.id)
      rescue Spaceship::UnexpectedResponse => e
        info = e.respond_to?(:error_info) ? e.error_info : nil
        UI.important("Chi tiết lỗi: #{JSON.pretty_generate(info)}") if info
        raise
      end
    end
    # IAP lần đầu: phải nộp SAU khi phiên bản đã vào lượt duyệt (Apple gắn IAP vào phiên bản đó)
    iaps = rc.get("v1/apps/#{app.id}/inAppPurchasesV2", { limit: 50 }).body["data"] || []
    iap_fail = []
    iaps.each do |i|
      a = i["attributes"]; st = a["state"]
      if st == "READY_TO_SUBMIT"
        begin
          rc.post("v1/inAppPurchaseSubmissions", { data: { type: "inAppPurchaseSubmissions", relationships: { inAppPurchaseV2: { data: { type: "inAppPurchases", id: i["id"] } } } } })
          UI.success("IAP #{a['productId']}: đã đưa vào lượt duyệt")
        rescue StandardError => e
          iap_fail << a["productId"]
          UI.important("IAP #{a['productId']}: không nộp được — #{e.message}")
        end
      else
        UI.important("IAP #{a['productId']}: trạng thái #{st} (không nộp)")
      end
    end
    # Không nộp app thiếu IAP (Apple sẽ từ chối vì nút mua không chạy); để lại bản nháp để sửa
    UI.user_error!("Dừng: #{iap_fail.size} IAP chưa vào lượt duyệt (#{iap_fail.join(', ')}) — app CHƯA được nộp") unless iap_fail.empty?
    sleep 5
    sub.submit_for_review
    UI.success("🚀 #{@game} #{ver.version_string} (build #{build.version}) đã Submit for Review")
  end

  desc "Thêm tester mặc định (fastlane/testers.txt) vào TestFlight: thành viên team → nhóm nội bộ, còn lại → nhóm ngoài + gửi Beta Review"
  lane :testers do
    api = Spaceship::ConnectAPI
    app = api::App.find(@bid) or UI.user_error!("Không thấy app #{@bid}")
    rc = api.client.tunes_request_client
    emails = File.readlines(File.expand_path("testers.txt", __dir__)).map(&:strip).reject { |l| l.empty? || l.start_with?("#") }
    UI.user_error!("testers.txt trống") if emails.empty?
    say = lambda do |label, &blk|
      begin
        r = blk.call
        UI.success(label)
        r
      rescue StandardError => e
        detail = e.respond_to?(:error_info) && e.error_info ? JSON.generate(e.error_info)[0, 500] : e.message[0, 500]
        UI.important("#{label}: LỖI — #{detail}")
        nil
      end
    end
    groups = rc.get("v1/apps/#{app.id}/betaGroups", { limit: 50 }).body["data"] || []
    ensure_group = lambda do |internal|
      name = internal ? "Team" : "Testers"
      g = groups.find { |x| x["attributes"]["isInternalGroup"] == internal }
      g ||= say.call("Tạo nhóm TestFlight #{name}") do
        attrs = internal ? { name: name, isInternalGroup: true, hasAccessToAllBuilds: true } : { name: name }
        rc.post("v1/betaGroups", { data: { type: "betaGroups", attributes: attrs,
          relationships: { app: { data: { type: "apps", id: app.id } } } } }).body["data"]
      end
      groups << g if g && !groups.include?(g)
      g
    end
    # Chờ build mới nhất xử lý xong (tối đa ~25 phút) để gắn được vào nhóm ngoài
    build = nil
    50.times do
      build = (rc.get("v1/builds", { "filter[app]" => app.id, sort: "-uploadedDate", limit: 1 }).body["data"] || []).first
      break if build.nil? || build["attributes"]["processingState"] != "PROCESSING"
      sleep 30
    end
    UI.message(build ? "Build mới nhất #{build['attributes']['version']} — #{build['attributes']['processingState']}" : "Chưa có build")
    need_review = false
    emails.each do |email|
      user = (rc.get("v1/users", { "filter[username]" => email, limit: 1 }).body["data"] || []).first rescue nil
      internal = !user.nil?
      g = ensure_group.call(internal) or next
      already = (rc.get("v1/betaGroups/#{g['id']}/betaTesters", { "filter[email]" => email, limit: 1 }).body["data"] || []).any? rescue false
      if already
        UI.message("#{email}: đã có trong nhóm #{internal ? 'nội bộ' : 'ngoài'}")
        need_review ||= !internal
        next
      end
      say.call("#{email} → nhóm #{internal ? 'nội bộ' : 'ngoài'}") do
        rc.post("v1/betaTesters", { data: { type: "betaTesters", attributes: { email: email },
          relationships: { betaGroups: { data: [{ type: "betaGroups", id: g["id"] }] } } } })
      end
      need_review ||= !internal
    end
    next unless need_review && build
    UI.user_error!("Build chưa xử lý xong, chạy lại lane testers sau ít phút") unless build["attributes"]["processingState"] == "VALID"
    ext = groups.find { |x| x["attributes"]["isInternalGroup"] == false }
    say.call("Gắn build #{build['attributes']['version']} vào nhóm ngoài") do
      rc.post("v1/betaGroups/#{ext['id']}/relationships/builds", { data: [{ type: "builds", id: build["id"] }] })
    end
    # Thông tin cần cho Beta App Review: lấy từ app khác của team nếu app này chưa có
    detail = rc.get("v1/apps/#{app.id}/betaAppReviewDetail").body["data"]
    if detail["attributes"]["contactEmail"].to_s.empty?
      src = nil
      (rc.get("v1/apps", { limit: 50 }).body["data"] || []).each do |a|
        next if a["id"] == app.id
        d = rc.get("v1/apps/#{a['id']}/betaAppReviewDetail").body["data"] rescue nil
        if d && !d["attributes"]["contactEmail"].to_s.empty? then src = d["attributes"]; break end
      end
      if src
        say.call("Điền liên hệ Beta Review (lấy từ app khác của team)") do
          rc.patch("v1/betaAppReviewDetails/#{detail['id']}", { data: { type: "betaAppReviewDetails", id: detail["id"],
            attributes: src.slice("contactFirstName", "contactLastName", "contactPhone", "contactEmail").merge("demoAccountRequired" => false) } })
        end
      else
        UI.important("Chưa có liên hệ Beta Review ở app nào — cần điền tay 1 lần (TestFlight › Test Information)")
      end
    end
    locs = rc.get("v1/apps/#{app.id}/betaAppLocalizations").body["data"] || []
    if locs.empty?
      desc = File.read("#{@dir}/metadata/en-US/description.txt").strip[0, 3900] rescue "Test build."
      say.call("Mô tả bản beta + email góp ý") do
        rc.post("v1/betaAppLocalizations", { data: { type: "betaAppLocalizations",
          attributes: { locale: "en-US", description: desc, feedbackEmail: "bm.apple.publish@gmail.com" },
          relationships: { app: { data: { type: "apps", id: app.id } } } } })
      end
    end
    bl = rc.get("v1/builds/#{build['id']}/betaBuildLocalizations").body["data"] || []
    if bl.empty?
      say.call("What to Test") do
        rc.post("v1/betaBuildLocalizations", { data: { type: "betaBuildLocalizations",
          attributes: { locale: "en-US", whatsNew: "Please play the first boards, flagging, continue after a bomb, and test in-app purchases (sandbox) and Restore Purchases." },
          relationships: { build: { data: { type: "builds", id: build["id"] } } } } })
      end
    end
    say.call("Gửi build #{build['attributes']['version']} cho Beta App Review (lần đầu Apple duyệt ~1 ngày, các bản sau thường tự qua)") do
      rc.post("v1/betaAppReviewSubmissions", { data: { type: "betaAppReviewSubmissions",
        relationships: { build: { data: { type: "builds", id: build["id"] } } } } })
    end
  end

  desc "Thiết lập Store qua API: giá app $0 + mọi quốc gia, tạo IAP từ Games/<game>/iap.json (tên/mô tả, giá, quốc gia)"
  lane :store do
    api = Spaceship::ConnectAPI
    app = api::App.find(@bid) or UI.user_error!("Không thấy app #{@bid}")
    rc = api.client.tunes_request_client
    step = lambda do |label, &blk|
      begin
        blk.call
        UI.success(label)
      rescue StandardError => e
        detail = e.respond_to?(:error_info) && e.error_info ? JSON.generate(e.error_info)[0, 600] : e.message[0, 600]
        UI.important("#{label}: LỖI — #{detail}")
      end
    end
    territories = []
    url = "v1/territories"
    params = { limit: 200 }
    loop do
      res = rc.get(url, params).body
      territories += (res["data"] || []).map { |t| t["id"] }
      nxt = res.dig("links", "next")
      break unless nxt
      url = nxt.sub(%r{^https://[^/]+/}, ""); params = {}
    end
    UI.message("#{territories.size} quốc gia")

    step.call("Giá app = Free") do
      free = rc.get("v1/apps/#{app.id}/appPricePoints", { "filter[territory]" => "USA", limit: 1 }).body["data"].first
      rc.post("v1/appPriceSchedules", {
        data: { type: "appPriceSchedules", relationships: {
          app: { data: { type: "apps", id: app.id } },
          baseTerritory: { data: { type: "territories", id: "USA" } },
          manualPrices: { data: [{ type: "appPrices", id: "${p0}" }] } } },
        included: [{ type: "appPrices", id: "${p0}", attributes: { startDate: nil },
                     relationships: { appPricePoint: { data: { type: "appPricePoints", id: free["id"] } } } }]
      })
    end

    step.call("App có mặt ở mọi quốc gia") do
      rc.post("v2/appAvailabilities", {
        data: { type: "appAvailabilities", attributes: { availableInNewTerritories: true }, relationships: {
          app: { data: { type: "apps", id: app.id } },
          territoryAvailabilities: { data: territories.map { |t| { type: "territoryAvailabilities", id: "${t#{t}}" } } } } },
        included: territories.map { |t| { type: "territoryAvailabilities", id: "${t#{t}}", attributes: { available: true },
                                           relationships: { territory: { data: { type: "territories", id: t } } } } }
      })
    end

    list = JSON.parse(File.read("#{@dir}/iap.json"))
    existing = rc.get("v1/apps/#{app.id}/inAppPurchasesV2", { limit: 50 }).body["data"] || []
    list.each do |p|
      pid = p["productId"]
      iap = existing.find { |i| i["attributes"]["productId"] == pid }
      if iap
        UI.message("IAP #{pid}: đã có, bỏ qua bước tạo")
      else
        step.call("IAP #{pid}: tạo") do
          iap = rc.post("v2/inAppPurchases", { data: { type: "inAppPurchases",
            attributes: { name: p["ref"], productId: pid, inAppPurchaseType: p["type"], familySharable: false },
            relationships: { app: { data: { type: "apps", id: app.id } } } } }).body["data"]
        end
        next unless iap
      end
      id = iap["id"]
      locs = rc.get("v2/inAppPurchases/#{id}/inAppPurchaseLocalizations").body["data"] || []
      { "en-US" => p["en"], "vi" => p["vi"] }.each do |locale, t|
        next if locs.any? { |l| l["attributes"]["locale"] == locale }
        step.call("IAP #{pid}: tên/mô tả #{locale}") do
          rc.post("v1/inAppPurchaseLocalizations", { data: { type: "inAppPurchaseLocalizations",
            attributes: { locale: locale, name: t["name"], description: t["desc"] },
            relationships: { inAppPurchaseV2: { data: { type: "inAppPurchases", id: id } } } } })
        end
      end
      step.call("IAP #{pid}: giá $#{p['price']}") do
        point = nil
        url = "v2/inAppPurchases/#{id}/pricePoints"
        params = { "filter[territory]" => "USA", limit: 200 }
        while point.nil?
          res = rc.get(url, params).body
          point = (res["data"] || []).find { |pp| pp["attributes"]["customerPrice"].to_f == p["price"].to_f }
          nxt = res.dig("links", "next")
          break if point || nxt.nil?
          url = nxt.sub(%r{^https://[^/]+/}, ""); params = {}
        end
        UI.user_error!("không thấy mức giá #{p['price']}") unless point
        rc.post("v1/inAppPurchasePriceSchedules", {
          data: { type: "inAppPurchasePriceSchedules", relationships: {
            inAppPurchase: { data: { type: "inAppPurchases", id: id } },
            baseTerritory: { data: { type: "territories", id: "USA" } },
            manualPrices: { data: [{ type: "inAppPurchasePrices", id: "${p0}" }] } } },
          included: [{ type: "inAppPurchasePrices", id: "${p0}", attributes: { startDate: nil },
                       relationships: { inAppPurchasePricePoint: { data: { type: "inAppPurchasePricePoints", id: point["id"] } } } }]
        })
      end
      step.call("IAP #{pid}: bán ở mọi quốc gia") do
        rc.post("v1/inAppPurchaseAvailabilities", { data: { type: "inAppPurchaseAvailabilities",
          attributes: { availableInNewTerritories: true }, relationships: {
            inAppPurchase: { data: { type: "inAppPurchases", id: id } },
            availableTerritories: { data: territories.map { |t| { type: "territories", id: t } } } } } })
      end
    end
    UI.success("✅ Store #{@game}: xong phần qua API (còn App Privacy, Age Rating, ảnh duyệt IAP)")
  end

  desc "Sau khi bị 2.1 Information Needed: cập nhật Review Notes từ metadata và Resubmit"
  lane :resubmit do
    api = Spaceship::ConnectAPI
    app = api::App.find(@bid) or UI.user_error!("Không thấy app #{@bid}")
    rc = api.client.tunes_request_client
    notes = File.read("#{@dir}/metadata/review_information/notes.txt").strip
    vers = rc.get("v1/apps/#{app.id}/appStoreVersions", { limit: 5 }).body["data"]
    ver = vers.find { |v| %w[REJECTED METADATA_REJECTED DEVELOPER_REJECTED PREPARE_FOR_SUBMISSION].include?(v["attributes"]["appStoreState"]) } or UI.user_error!("Không có phiên bản bị từ chối")
    rd = rc.get("v1/appStoreVersions/#{ver['id']}/appStoreReviewDetail").body["data"]
    rc.patch("v1/appStoreReviewDetails/#{rd['id']}", { data: { type: "appStoreReviewDetails", id: rd["id"], attributes: { notes: notes } } })
    UI.success("Đã cập nhật Review Notes (#{ver['attributes']['versionString']})")
    subs = rc.get("v1/reviewSubmissions", { "filter[app]" => app.id, limit: 5 }).body["data"]
    sub = subs.find { |x| x["attributes"]["state"] == "UNRESOLVED_ISSUES" } or UI.user_error!("Không có lượt nộp UNRESOLVED_ISSUES")
    items = rc.get("v1/reviewSubmissions/#{sub['id']}/items").body["data"] || []
    items.each do |it|
      UI.message("Mục #{it['id'][0, 12]}…: #{it['attributes']['state']}")
      next unless %w[REJECTED READY_FOR_REVIEW].include?(it["attributes"]["state"])
      begin
        rc.patch("v1/reviewSubmissionItems/#{it['id']}", { data: { type: "reviewSubmissionItems", id: it["id"], attributes: { resubmitted: true } } })
        UI.success("Đánh dấu resubmitted")
      rescue StandardError => e
        UI.important("Không đánh dấu được: #{e.message}")
      end
    end
    begin
      rc.patch("v1/reviewSubmissions/#{sub['id']}", { data: { type: "reviewSubmissions", id: sub["id"], attributes: { submitted: true } } })
    rescue Spaceship::UnexpectedResponse => e
      UI.important("Chi tiết lỗi: #{JSON.pretty_generate(e.error_info)}") if e.respond_to?(:error_info) && e.error_info
      raise
    end
    UI.success("🚀 #{@game} đã Resubmit to App Review")
  end

  desc "Thêm tên/mô tả IAP cho các ngôn ngữ mới từ Games/<game>/iap_locales.json (bỏ qua ngôn ngữ đã có)"
  lane :iaploc do
    api = Spaceship::ConnectAPI
    app = api::App.find(@bid) or UI.user_error!("Không thấy app #{@bid}")
    rc = api.client.tunes_request_client
    existing = rc.get("v1/apps/#{app.id}/inAppPurchasesV2", { limit: 50 }).body["data"] || []
    JSON.parse(File.read("#{@dir}/iap_locales.json")).each do |p|
      iap = existing.find { |i| i["attributes"]["productId"] == p["productId"] } or (UI.important("Không thấy #{p['productId']}"); next)
      locs = (rc.get("v2/inAppPurchases/#{iap['id']}/inAppPurchaseLocalizations").body["data"] || []).map { |l| l["attributes"]["locale"] }
      p["locales"].each do |locale, t|
        next if locs.include?(locale)
        begin
          rc.post("v1/inAppPurchaseLocalizations", { data: { type: "inAppPurchaseLocalizations",
            attributes: { locale: locale, name: t["name"], description: t["desc"] },
            relationships: { inAppPurchaseV2: { data: { type: "inAppPurchases", id: iap["id"] } } } } })
          UI.success("#{p['productId']} #{locale}")
        rescue StandardError => e
          UI.important("#{p['productId']} #{locale}: #{e.message[0, 300]}")
        end
      end
    end
  end
end
